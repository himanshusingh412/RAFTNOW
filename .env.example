# Copy to .env.local and fill in. Never commit real values. All keys are yours: create
# each account yourself (Claude never signs up for services or handles live keys).

# Supabase -> Project Settings -> API (use the Mumbai region, ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server only; bypasses row level security
SUPABASE_SECRET_KEY=

# where the site runs, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay -> Account & Settings -> API Keys. TEST MODE keys (rzp_test_...) until /replica-deploy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Webhooks -> the secret you type when adding https://<site>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Resend -> API Keys; EMAIL_FROM must be on a domain you verified in Resend
RESEND_API_KEY=
EMAIL_FROM="Rafting App <bookings@your-domain.in>"

# any random 32+ character string; Vercel Cron sends it as a Bearer token
# generate one with: openssl rand -hex 32
CRON_SECRET=
