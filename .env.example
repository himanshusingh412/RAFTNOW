# ─────────────────────────────────────────────────────────────────────────────
# RaftNow environment configuration — copy to .env and fill in real values.
# NEVER commit the real .env. docker-compose.yml reads this file automatically.
#
# With APP_ENV=production the API REFUSES TO START if any required secret is
# missing or still a placeholder (see apps/api/src/common/config/env.validation.ts).
# In development missing integrations only log warnings and the affected
# features return explicit "not configured" errors.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_VERSION=0.0.1
PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
TRUST_PROXY=false              # true when running behind Nginx / a load balancer
RATE_LIMIT_PER_MINUTE=120

# ── PostgreSQL (docker-compose maps the container to localhost:5434) ───────────
DATABASE_URL="postgresql://raftnow:raftnow_dev@localhost:5434/raftnow?schema=public&connection_limit=20"
# Integration tests (real DB). Create + migrate once:
#   createdb raftnow_test; DATABASE_URL=$DATABASE_URL_TEST npx prisma migrate deploy
DATABASE_URL_TEST="postgresql://raftnow:raftnow_dev@localhost:5434/raftnow_test?schema=public&connection_limit=20"
DB_TX_MAX_WAIT_MS=15000
DB_TX_TIMEOUT_MS=15000

# ── Redis (provisioned by docker-compose; not used by application code yet — ──
#    background jobs run on pg-boss inside PostgreSQL)
REDIS_URL=redis://localhost:6380

# ── Auth: Firebase phone OTP (customers + operator staff) ─────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=          # "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web app Firebase config (public values, baked into the web build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# LOCAL DEVELOPMENT ONLY: accept "dev:<uid>:<+E164 phone>" bearer tokens instead
# of Firebase. Forbidden (boot fails) when APP_ENV=production.
AUTH_DEV_BYPASS=true

# ── Admin sessions (email + password + mandatory TOTP 2FA) ────────────────────
JWT_SECRET=                    # >= 32 random chars: openssl rand -hex 32
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@raftnow.in
SEED_ADMIN_PASSWORD=           # >= 12 chars; required by the seed in production

# ── Encryption of PAN / bank account / TOTP secrets (AES-256-GCM) ─────────────
FIELD_ENCRYPTION_KEY=          # 32 bytes, hex or base64: openssl rand -hex 32

# ── QR ticket signing ─────────────────────────────────────────────────────────
QR_SIGNING_SECRET=             # >= 32 random chars: openssl rand -hex 32

# ── Razorpay (payments, refunds, Route payouts) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=       # Dashboard → Settings → Webhooks; URL: https://<api>/api/v1/webhooks/razorpay

# ── Private KYC document storage ───────────────────────────────────────────────
STORAGE_DRIVER=local           # s3 (production) | local (development)
STORAGE_LOCAL_DIR=./data/private-uploads
STORAGE_PUBLIC_DIR=./data/public-media   # local driver: trip photos (public), kept apart from KYC documents
STORAGE_SIGNING_SECRET=        # >= 32 chars; signs expiring download links (local driver)
API_PUBLIC_URL=                # optional absolute base for signed download links
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=raftnow-private-docs   # Block Public Access ON; SSE enabled
S3_BUCKET_PUBLIC=raftnow-public-media      # trip photos; served publicly (bucket policy or CDN)
PUBLIC_MEDIA_BASE_URL=                    # e.g. https://media.raftnow.in — required with STORAGE_DRIVER=s3
S3_ENDPOINT=                   # optional (S3-compatible storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Notification providers (each channel is used only if configured) ─────────
SENDGRID_API_KEY=
EMAIL_FROM=
FAST2SMS_API_KEY=
NOTIFICATION_MAX_ATTEMPTS=5
# PUSH uses Firebase Cloud Messaging via the Firebase Admin credentials above.
# WhatsApp requires approved templates — not implemented yet (recorded as SKIPPED).

# ── Business rules ─────────────────────────────────────────────────────────────
BOOKING_HOLD_TTL_MINUTES=10
BOOKING_WINDOW_DAYS=60
DEFAULT_COMMISSION_BPS=1000            # 10%
TRANSFER_HOLD_HOURS=24                 # vendor payout released this long after slot end
AUTO_COMPLETE_AFTER_HOURS=2
SLOT_GENERATION_DAYS=14
CHECKIN_OPENS_HOURS_BEFORE=4
CHECKIN_GRACE_HOURS_AFTER_END=2
VENDOR_CANCELLATION_RELIABILITY_PENALTY=5

# ── Operations ─────────────────────────────────────────────────────────────────
DISABLE_BACKGROUND_JOBS=false          # true in tests
JOBS_DB_POOL_MAX=4
OPS_ALERT_EMAIL=ops@raftnow.in

# ── Mobile (Expo) ──────────────────────────────────────────────────────────────
# Phones cannot reach "localhost" on your computer — use its LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
